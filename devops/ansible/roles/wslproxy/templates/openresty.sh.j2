#!/bin/bash

set -x

{% if target_env != 'prod' %}
# Remove openresty-admin directory if it exists before installing OpenResty
# This only runs in non-production environments (current: {{ target_env }})
if [ -d /usr/local/openresty/nginx/html/openresty-admin ]; then
  rm -rf /usr/local/openresty/nginx/html/openresty-admin
fi
{% else %}
# Skipping openresty-admin removal in production environment
echo "Production environment detected - preserving openresty-admin directory"
{% endif %}

# OS family detected by Ansible: {{ ansible_os_family }}

# Install build dependencies based on OS
install_build_deps() {
{% if ansible_os_family == "Suse" %}
  zypper --non-interactive install {{ os_build_deps | join(' ') }} || true
{% elif ansible_os_family == "RedHat" %}
  dnf install -y {{ os_build_deps | join(' ') }}
  # Add OpenResty yum repo for opm
  wget https://openresty.org/package/centos/openresty.repo -O /etc/yum.repos.d/openresty.repo || true
  dnf install -y openresty-opm || true
{% else %}
  # Debian/Ubuntu
{% if ansible_distribution == "Ubuntu" %}
  # Setup OpenResty apt repo for Ubuntu
  UBUNTU_VERSION=$(lsb_release -rs | cut -d. -f1)
  if [ "$UBUNTU_VERSION" -ge 22 ]; then
    echo "Ubuntu ${UBUNTU_VERSION} detected"
    rm -f /usr/share/keyrings/openresty.gpg
    wget -O - https://openresty.org/package/pubkey.gpg | sudo gpg --dearmor -o /usr/share/keyrings/openresty.gpg
    echo "deb [arch=$(dpkg --print-architecture) signed-by=/usr/share/keyrings/openresty.gpg] http://openresty.org/package/ubuntu $(lsb_release -sc) main" | sudo tee /etc/apt/sources.list.d/openresty.list > /dev/null
    apt-get update
    apt-get install ldconfig -y
    apt-get -y install openresty-opm
  fi
{% endif %}
  apt-get install {{ os_build_deps | join(' ') }} -y
{% endif %}
}

# Set OpenResty source directory
OPENRESTY_SRC_DIR=/usr/local/openresty

mkdir -p /usr/local/openresty/nginx/logs/
chmod 777 -R /usr/local/openresty/nginx/logs/

mkdir -p $OPENRESTY_SRC_DIR

source ~/.bashrc

install_build_deps

# Function to build OpenResty
build_openresty() {

# download nginx third party modules to be compiled with openresty
 cd /tmp
 git clone https://github.com/ffutop/ngx_http_env_module.git || true

OPENRESTY_VERSION="1.27.1.2"
wget https://openresty.org/download/openresty-${OPENRESTY_VERSION}.tar.gz
tar -xzf openresty-${OPENRESTY_VERSION}.tar.gz
cd openresty-${OPENRESTY_VERSION}

  ./configure --prefix=$OPENRESTY_SRC_DIR --with-stream_realip_module --with-http_ssl_module --with-http_gzip_static_module --with-http_sub_module --with-http_v2_module --with-http_stub_status_module --with-stream --with-http_slice_module
  gmake -j2
  gmake install
  ln -sf /usr/local/openresty/nginx/sbin/nginx /usr/bin/openresty

  # Installed OpenResty
  # Show OpenResty version
  mkdir -p /opt/nginx/
  /usr/bin/openresty -v 2> /opt/nginx/VERSION

echo "Building OpenResty ${OPENRESTY_VERSION} completed"
}

# Install luarocks from source if not available via package manager
install_luarocks() {
  # Ensure OpenResty binaries are in PATH
  export PATH="/usr/local/openresty/luajit/bin:/usr/local/openresty/bin:/usr/local/bin:$PATH"

  if command -v luarocks &> /dev/null; then
    echo "luarocks already installed: $(luarocks --version)"
    return 0
  fi

  echo "Installing luarocks from source..."
  LUAROCKS_VERSION="3.11.1"

  # Verify LuaJIT is available from the OpenResty build
  if [ ! -f /usr/local/openresty/luajit/bin/luajit ]; then
    echo "ERROR: LuaJIT not found at /usr/local/openresty/luajit/bin/luajit"
    ls -la /usr/local/openresty/luajit/bin/ 2>/dev/null || echo "Directory does not exist"
    return 1
  fi
  echo "Found LuaJIT: $(/usr/local/openresty/luajit/bin/luajit -v)"

  # Verify include directory exists
  if [ ! -d /usr/local/openresty/luajit/include/luajit-2.1 ]; then
    echo "ERROR: LuaJIT include directory not found"
    ls -la /usr/local/openresty/luajit/include/ 2>/dev/null || echo "Include directory does not exist"
    return 1
  fi

  cd /tmp
  rm -f luarocks-${LUAROCKS_VERSION}.tar.gz
  echo "Downloading luarocks ${LUAROCKS_VERSION}..."
  wget https://luarocks.github.io/luarocks/releases/luarocks-${LUAROCKS_VERSION}.tar.gz
  if [ $? -ne 0 ] || [ ! -f luarocks-${LUAROCKS_VERSION}.tar.gz ]; then
    echo "ERROR: Failed to download luarocks"
    return 1
  fi

  rm -rf luarocks-${LUAROCKS_VERSION}
  tar xzf luarocks-${LUAROCKS_VERSION}.tar.gz
  cd luarocks-${LUAROCKS_VERSION}

  echo "Configuring luarocks..."
  ./configure --prefix=/usr/local/openresty/luajit \
    --with-lua=/usr/local/openresty/luajit \
    --lua-suffix=jit \
    --with-lua-include=/usr/local/openresty/luajit/include/luajit-2.1
  if [ $? -ne 0 ]; then
    echo "ERROR: luarocks configure failed"
    return 1
  fi

  echo "Building luarocks..."
  make
  if [ $? -ne 0 ]; then
    echo "ERROR: luarocks make failed"
    return 1
  fi

  echo "Installing luarocks..."
  make install
  if [ $? -ne 0 ]; then
    echo "ERROR: luarocks make install failed"
    return 1
  fi

  # Create symlink so luarocks is in standard PATH
  ln -sf /usr/local/openresty/luajit/bin/luarocks /usr/local/bin/luarocks

  cd /tmp
  rm -rf luarocks-${LUAROCKS_VERSION} luarocks-${LUAROCKS_VERSION}.tar.gz

  # Verify installation
  if command -v luarocks &> /dev/null; then
    echo "luarocks installed successfully: $(luarocks --version 2>&1 | head -1)"
  else
    echo "ERROR: luarocks not found after installation"
    ls -la /usr/local/openresty/luajit/bin/luarocks 2>/dev/null || echo "Binary not at expected path"
    return 1
  fi
}

# Main script
echo "=== Starting OpenResty build ==="
build_openresty
echo "=== OpenResty build complete ==="

echo "=== Starting luarocks installation ==="
install_luarocks
LUAROCKS_RC=$?
if [ $LUAROCKS_RC -ne 0 ]; then
  echo "WARNING: luarocks installation failed (exit code: $LUAROCKS_RC)"
  echo "Lua modules installed via luarocks will not be available"
fi
echo "=== Script complete ==="
