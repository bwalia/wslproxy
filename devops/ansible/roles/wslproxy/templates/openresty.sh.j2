#!/bin/bash

set -x

{% if target_env != 'prod' %}
# Remove openresty-admin directory if it exists before installing OpenResty
# This only runs in non-production environments (current: {{ target_env }})
if [ -d /usr/local/openresty/nginx/html/openresty-admin ]; then
  rm -rf /usr/local/openresty/nginx/html/openresty-admin
fi
{% else %}
# Skipping openresty-admin removal in production environment
echo "Production environment detected - preserving openresty-admin directory"
{% endif %}

# Detect OS family
if command -v zypper &> /dev/null; then
  OS_FAMILY="suse"
elif command -v apt-get &> /dev/null; then
  OS_FAMILY="debian"
else
  echo "Unsupported OS"
  exit 1
fi

# Install build dependencies based on OS
install_build_deps() {
  if [ "$OS_FAMILY" = "suse" ]; then
    zypper --non-interactive install pcre-devel libopenssl-devel perl make gcc wget zlib-devel || true
  else
    # For ubuntu 22 or above
    if (lsb_release -r | grep -q "22"); then
      echo "Ubuntu 22 or above"
      rm -f /usr/share/keyrings/openresty.gpg
      wget -O - https://openresty.org/package/pubkey.gpg | sudo gpg --dearmor -o /usr/share/keyrings/openresty.gpg
      echo "deb [arch=$(dpkg --print-architecture) signed-by=/usr/share/keyrings/openresty.gpg] http://openresty.org/package/ubuntu $(lsb_release -sc) main" | sudo tee /etc/apt/sources.list.d/openresty.list > /dev/null
      apt-get update
      apt-get install ldconfig -y
      apt-get -y install openresty-opm
    fi

    if (lsb_release -r | grep -q "24"); then
      echo "Ubuntu 24 or above"
      rm -f /usr/share/keyrings/openresty.gpg
      wget -O - https://openresty.org/package/pubkey.gpg | sudo gpg --dearmor -o /usr/share/keyrings/openresty.gpg
      echo "deb [arch=$(dpkg --print-architecture) signed-by=/usr/share/keyrings/openresty.gpg] http://openresty.org/package/ubuntu $(lsb_release -sc) main" | sudo tee /etc/apt/sources.list.d/openresty.list > /dev/null
      apt-get update
      apt-get install ldconfig -y
      apt-get -y install openresty-opm
    fi

    apt-get install libpcre3-dev \
        libssl-dev perl make build-essential curl zlib1g-dev -y
    apt-get install make gcc wget -y
  fi
}

# Set OpenResty source directory
OPENRESTY_SRC_DIR=/usr/local/openresty

mkdir -p /usr/local/openresty/nginx/logs/
chmod 777 -R /usr/local/openresty/nginx/logs/

mkdir -p $OPENRESTY_SRC_DIR

source ~/.bashrc

install_build_deps

# Function to build OpenResty
build_openresty() {

# download nginx third party modules to be compiled with openresty
 cd /tmp
 git clone https://github.com/ffutop/ngx_http_env_module.git || true

# OPENRESTY_VERSION="1.25.3.2"
OPENRESTY_VERSION="1.27.1.2"
wget https://openresty.org/download/openresty-${OPENRESTY_VERSION}.tar.gz
tar -xzf openresty-${OPENRESTY_VERSION}.tar.gz
cd openresty-${OPENRESTY_VERSION}

  ./configure --prefix=$OPENRESTY_SRC_DIR --with-stream_realip_module --with-http_ssl_module --with-http_gzip_static_module --with-http_sub_module --with-http_v2_module --with-http_stub_status_module --with-stream --with-http_slice_module
  gmake -j2
  gmake install
  ln -sf /usr/local/openresty/nginx/sbin/nginx /usr/bin/openresty

  # Installed OpenResty
  # Show OpenResty version
  mkdir -p /opt/nginx/
  /usr/bin/openresty -v 2> /opt/nginx/VERSION

echo "Building OpenResty ${OPENRESTY_VERSION} completed"
}

# Main script
build_openresty
# exit 0
