    # Default server configuration
    # Hostname: {{ nginx_default_server_hostname }}
    # Let's Encrypt Email: {{ letsencrypt_email }}
    #
    # HTTP server block (port 80)
    # Serves landing page for the default hostname and direct IP access
    server {
        listen       80;
        server_name  {{ nginx_default_server_hostname }} {{ host_lan_ip | default('') }};

        # ACME Challenge for Let's Encrypt certificate validation
        location /.well-known/acme-challenge/ {
            content_by_lua_block {
                auto_ssl:challenge_server()
            }
        }

        location / {
            root   html;
            index  index.html index.htm;
        }
    }

    # HTTPS server block (port 443) with Let's Encrypt auto-ssl
    server {
        listen       443 ssl;
        server_name  {{ nginx_default_server_hostname }};

        http2 on;

        # SSL session settings
        ssl_session_timeout  5m;
        ssl_session_cache shared:default_ssl:10m;
        ssl_session_tickets off;

        # Modern TLS configuration
        ssl_protocols TLSv1.2 TLSv1.3;
        ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305:DHE-RSA-AES128-GCM-SHA256:DHE-RSA-AES256-GCM-SHA384;
        ssl_prefer_server_ciphers off;

        # Dynamic SSL certificate via lua-resty-auto-ssl
        ssl_certificate_by_lua_block {
            auto_ssl:ssl_certificate()
        }

        # Fallback certificate (used until Let's Encrypt cert is issued)
        ssl_certificate /etc/ssl/resty-auto-ssl-fallback.crt;
        ssl_certificate_key /etc/ssl/resty-auto-ssl-fallback.key;

        # HSTS - enforce HTTPS for 1 year
        add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

        # ACME Challenge for Let's Encrypt certificate validation
        location /.well-known/acme-challenge/ {
            content_by_lua_block {
                auto_ssl:challenge_server()
            }
        }

        location / {
            root   html;
            index  index.html index.htm;
        }
    }
