#!/bin/bash

set -x

# Download and install nvm
curl -o- https://raw.githubusercontent.com/nvm-sh/nvm/v0.39.3/install.sh | bash

source ~/.bashrc
# Set nvm environment variables
export NVM_DIR="${HOME}/.nvm"

# Load nvm
[ -s "$NVM_DIR/nvm.sh" ] && \. "$NVM_DIR/nvm.sh"  # This loads nvm

# Install fixed version of Node v18 and Use it. Install Yarn
nvm install 18
nvm use 18
npm install --global yarn

mkdir -p /usr/local/openresty/nginx/html/openresty-admin/
chmod 777 /usr/local/openresty/nginx/html/openresty-admin/

cd /usr/local/openresty/nginx/html/openresty-admin/

# Create proper .env file for Vite build with VITE_ prefixed variables
# Extract API URLs from settings.json if available
if [ -f "/opt/nginx/data/settings.json" ]; then
  CONTROL_PLANE_API_URL=$(python3 -c "import json; data=json.load(open('/opt/nginx/data/settings.json')); print(data.get('env_vars', {}).get('CONTROL_PLANE_API_URL', 'https://localhost/api'))" 2>/dev/null || echo "https://localhost/api")
  FRONT_URL=$(python3 -c "import json; data=json.load(open('/opt/nginx/data/settings.json')); print(data.get('env_vars', {}).get('FRONT_URL', 'https://localhost'))" 2>/dev/null || echo "https://localhost")
else
  CONTROL_PLANE_API_URL="https://localhost/api"
  FRONT_URL="https://localhost"
fi

# Create .env file with Vite convention (VITE_ prefix)
cat > /usr/local/openresty/nginx/html/openresty-admin/.env << EOF
VITE_API_URL=${CONTROL_PLANE_API_URL}
VITE_FRONT_URL=${FRONT_URL}
VITE_APP_VERSION={{ wslproxy_version | default('1.0.0') }}
VITE_APP_BUILD_NUMBER={{ wslproxy_build_number | default('unknown') }}
VITE_DEPLOYMENT_TIME={{ wslproxy_deployment_time | default(ansible_date_time.iso8601) }}
EOF

# Also copy original .env if it exists for reference
if [ -f "/tmp/.env" ]; then
  cat /tmp/.env >> /usr/local/openresty/nginx/html/openresty-admin/.env
fi

# Install dependencies and build the project
yarn cache clean
rm -Rf yarn.lock
yarn install
    {% if node_max_old_space_size is defined %}
      export NODE_OPTIONS="--max_old_space_size={{ node_max_old_space_size }}"
    {% else %}
      export NODE_OPTIONS="--max_old_space_size=1024"
    {% endif %}

# Export variables for the build process
export VITE_API_URL="${CONTROL_PLANE_API_URL}"
export VITE_FRONT_URL="${FRONT_URL}"

# Export version, build, and deployment time for dashboard footer
export VITE_APP_VERSION="{{ wslproxy_version | default('1.0.0') }}"
export VITE_APP_BUILD_NUMBER="{{ wslproxy_build_number | default('unknown') }}"
export VITE_DEPLOYMENT_TIME="{{ wslproxy_deployment_time | default(ansible_date_time.iso8601) }}"

yarn build
