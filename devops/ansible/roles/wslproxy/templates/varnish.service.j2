# Varnish systemd service override for WSLProxy
# Managed by Ansible - do not edit manually
[Service]
ExecStart=
ExecStart=/usr/sbin/varnishd \
  -a {{ varnish_listen_address | default('127.0.0.1') }}:{{ varnish_listen_port | default('6081') }} \
  -T {{ varnish_admin_listen_address | default('127.0.0.1') }}:{{ varnish_admin_listen_port | default('6082') }} \
  -f /etc/varnish/default.vcl \
  -s malloc,{{ varnish_cache_size | default('256m') }} \
  -p thread_pool_min={{ varnish_thread_pool_min | default('5') }} \
  -p thread_pool_max={{ varnish_thread_pool_max | default('1000') }} \
  -p workspace_client={{ varnish_workspace_client | default('64000') }} \
  -p workspace_backend={{ varnish_workspace_backend | default('131072') }}

LimitNOFILE=131072
LimitMEMLOCK=infinity
