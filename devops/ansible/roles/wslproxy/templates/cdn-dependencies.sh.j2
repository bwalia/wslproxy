#!/bin/bash

set -x

# Set PATH to include OpenResty and luarocks binaries
export PATH="/usr/local/openresty/luajit/bin:/usr/local/openresty/bin:/usr/local/bin:$PATH"

# Verify luarocks is available
if ! command -v luarocks &> /dev/null; then
  echo "ERROR: luarocks not found in PATH"
  echo "PATH=$PATH"
  exit 1
fi
echo "Using luarocks: $(which luarocks)"
echo "Luarocks version: $(luarocks --version 2>&1 | head -1)"
echo "Luarocks default tree: $(luarocks config deploy_lua_dir 2>/dev/null || echo 'unknown')"

opm remove pintsized/lua-resty-http || true
opm remove ledgetech/lua-resty-http || true

opm get olegabr/lua-resty-ip2location || true
opm get ip2location/ip2location-resty || true
opm get bungle/lua-resty-session || true
opm get bungle/lua-resty-template || true
opm get thibaultcha/lua-resty-mlcache || true
opm get 3scale/lua-resty-env || true

# Install Lua modules via luarocks
# Use explicit tree to ensure modules land where nginx can find them
LUAROCKS_FAILED=0
install_rock() {
  echo ">>> Installing $1 ..."
  if luarocks install "$1" 2>&1; then
    echo ">>> $1 installed successfully"
  else
    echo ">>> FAILED to install $1"
    LUAROCKS_FAILED=1
  fi
}

install_rock lua-resty-jwt
install_rock lua-resty-session
install_rock lua-resty-http
install_rock lua-resty-openidc
install_rock base64
install_rock lua-resty-redis-connector
install_rock lua-resty-dns
install_rock lua-resty-resolver
install_rock luafilesystem
install_rock lua-resty-auto-ssl
install_rock pgmoon
install_rock lua-resty-consul

# Show where modules were installed
echo "=== Luarocks installation summary ==="
echo "Installed rocks:"
luarocks list 2>&1
echo "Lua paths configured by luarocks:"
luarocks path 2>&1
echo "Looking for jwt.lua:"
find /usr/local/openresty /usr/local/share /usr/local/lib -name "jwt.lua" -path "*/resty/*" 2>/dev/null || echo "jwt.lua NOT FOUND"
if [ $LUAROCKS_FAILED -ne 0 ]; then
  echo "WARNING: Some luarocks packages failed to install"
fi

# Install nginx-lua-prometheus for Prometheus metrics
cd /tmp && \
    rm -rf nginx-lua-prometheus && \
    git clone https://github.com/knyar/nginx-lua-prometheus.git && \
    cp /tmp/nginx-lua-prometheus/prometheus.lua /usr/local/openresty/lualib/ && \
    cp /tmp/nginx-lua-prometheus/prometheus_keys.lua /usr/local/openresty/lualib/ && \
    cp /tmp/nginx-lua-prometheus/prometheus_resty_counter.lua /usr/local/openresty/lualib/ && \
    rm -rf /tmp/nginx-lua-prometheus

# Install lua-resty-upstream-healthcheck for active health checks on upstreams
cd /tmp && \
    rm -rf lua-resty-upstream-healthcheck && \
    git clone https://github.com/openresty/lua-resty-upstream-healthcheck.git && \
    mkdir -p /usr/local/openresty/lualib/resty/upstream && \
    cp /tmp/lua-resty-upstream-healthcheck/lib/resty/upstream/healthcheck.lua /usr/local/openresty/lualib/resty/upstream/ && \
    rm -rf /tmp/lua-resty-upstream-healthcheck

mkdir -p /data/nginx/cache
chown -R www-data:root /data/nginx/cache
chmod -R 775 /data/nginx/cache

mkdir -p /var/log/nginx/
chown -R www-data:root /var/log/nginx/
chmod -R 775 /var/log/nginx/

mkdir -p /opt/nginx/data/ \
    && chmod -R 777 /opt/nginx/data/ \
    && chown -R www-data:root /opt/nginx/data/

mkdir -p /opt/nginx/data/rules/prod/ \
    && chmod -R 777 /opt/nginx/data/rules/prod/ \
    && chown -R www-data:root /opt/nginx/data/rules/prod/

mkdir -p /opt/nginx/data/rules/acc/ \
    && chmod -R 777 /opt/nginx/data/rules/acc/ \
    && chown -R www-data:root /opt/nginx/data/rules/acc/

mkdir -p /opt/nginx/data/rules/test/ \
    && chmod -R 777 /opt/nginx/data/rules/test/ \
    && chown -R www-data:root /opt/nginx/data/rules/test/

mkdir -p /opt/nginx/data/rules/int/ \
    && chmod -R 777 /opt/nginx/data/rules/int/ \
    && chown -R www-data:root /opt/nginx/data/rules/int/

mkdir -p /opt/nginx/data/servers/prod/ \
    && chmod -R 777 /opt/nginx/data/servers/prod/ \
    && chown -R www-data:root /opt/nginx/servers/rules/prod/

mkdir -p /opt/nginx/data/servers/acc/ \
    && chmod -R 777 /opt/nginx/data/servers/acc/ \
    && chown -R www-data:root /opt/nginx/data/servers/acc/

mkdir -p /opt/nginx/data/servers/test/ \
    && chmod -R 777 /opt/nginx/data/servers/test/ \
    && chown -R www-data:root /opt/nginx/data/servers/test/

mkdir -p /opt/nginx/data/servers/int/ \
    && chmod -R 777 /opt/nginx/data/servers/int/ \
    && chown -R www-data:root /opt/nginx/data/servers/int/

# Create upstreams directories for all environments
mkdir -p /opt/nginx/data/upstreams/prod/ \
    && chmod -R 777 /opt/nginx/data/upstreams/prod/ \
    && chown -R www-data:root /opt/nginx/data/upstreams/prod/ \
    && touch /opt/nginx/data/upstreams/prod/upstreams.conf

mkdir -p /opt/nginx/data/upstreams/acc/ \
    && chmod -R 777 /opt/nginx/data/upstreams/acc/ \
    && chown -R www-data:root /opt/nginx/data/upstreams/acc/ \
    && touch /opt/nginx/data/upstreams/acc/upstreams.conf

mkdir -p /opt/nginx/data/upstreams/test/ \
    && chmod -R 777 /opt/nginx/data/upstreams/test/ \
    && chown -R www-data:root /opt/nginx/data/upstreams/test/ \
    && touch /opt/nginx/data/upstreams/test/upstreams.conf

mkdir -p /opt/nginx/data/upstreams/int/ \
    && chmod -R 777 /opt/nginx/data/upstreams/int/ \
    && chown -R www-data:root /opt/nginx/data/upstreams/int/ \
    && touch /opt/nginx/data/upstreams/int/upstreams.conf

mkdir -p /etc/resty-auto-ssl
chown -R www-data:root /etc/resty-auto-ssl/
chmod -R 775 /etc/resty-auto-ssl

mkdir -p /etc/ssl/
chown -R www-data:root /etc/ssl/
chmod -R 775 /etc/ssl

openssl req -new -newkey rsa:2048 -days 3650 -nodes -x509 \
  -subj '/CN=sni-support-required-for-valid-ssl' \
  -keyout /etc/ssl/resty-auto-ssl-fallback.key \
  -out /etc/ssl/resty-auto-ssl-fallback.crt

# mc - MinIO Client is used to backup nginx openresty configuration to S3
wget https://dl.min.io/client/mc/release/linux-amd64/mc -O /usr/local/bin/mc \
    --tries=3 --timeout=30 && \
    chmod +x /usr/local/bin/mc  

mc --version

cd /tmp/ && wget https://edgeone-public.s3.eu-west-2.amazonaws.com/src/openresty/IP2LOCATION-LITE-DB11.IPV6.BIN/IP2LOCATION-LITE-DB11.IPV6.BIN -O /tmp/IP2LOCATION-LITE-DB11.IPV6.BIN
mv /tmp/IP2LOCATION-LITE-DB11.IPV6.BIN /usr/local/openresty/nginx/IP2LOCATION-LITE-DB11.IPV6.BIN

chmod 775 /usr/local/openresty/nginx/IP2LOCATION-LITE-DB11.IPV6.BIN \
    && chown www-data:root /usr/local/openresty/nginx/IP2LOCATION-LITE-DB11.IPV6.BIN

if [ -f "/tmp/.env" ]; then
  mkdir -p /usr/local/openresty/nginx/html/openresty-admin/
  cp /tmp/.env /usr/local/openresty/nginx/html/openresty-admin/.env
fi
