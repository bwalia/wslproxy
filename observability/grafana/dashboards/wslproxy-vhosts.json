          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Time 1": true,
              "Time 2": true,
              "Time 3": true
            },
            "renameByName": {
              "Value #A": "req/s",
              "Value #B": "5xx/s",
              "Value #C": "p95 (s)"
