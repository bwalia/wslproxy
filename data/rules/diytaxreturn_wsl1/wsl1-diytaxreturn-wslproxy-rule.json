{
  "id": "wsl1-diytaxreturn-wslproxy-rule",
  "created_at": 1769388395,
  "name": "wsl1-diytaxreturn-wslproxy-local",
  "profile_id": "wsl1",
  "priority": 1,
  "match": {
    "rules": {
      "path": "/",
      "path_key": "starts_with",
      "client_ip_key": "equals",
      "country_key": "equals",
      "jwt_token_validation": "equals"
    },
    "response": {
      "code": 305,
      "redirect_uri": "127.0.0.1:8080",
      "allow": false,
      "message": "undefined",
      "is_consul": false
    }
  },
  "version": 1,
  "servers": ["host:wsl1.diytaxreturn.co.uk"]
}
