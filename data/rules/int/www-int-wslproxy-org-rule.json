{
  "id": "www-int-wslproxy-org-rule",
  "created_at": 1769388395,
  "name": "www-int-wslproxy-org-local",
  "profile_id": "int",
  "priority": 1,
  "match": {
    "rules": {
      "path": "/",
      "path_key": "starts_with",
      "client_ip_key": "equals",
