{
    "id": "podinfo-demo-default",
    "match": {
        "response": {
            "allow": true,
            "auto_redirect_https": false,
            "backends": [
                {
                    "address": "72.62.211.28:30082",
                    "label": "podinfo-k3s1-nodeport",
                    "weight": 100
                }
            ],
            "code": 305,
            "is_consul": false,
            "redirect_uri": "72.62.211.28:30082",
            "routing": {
                "mode": "least_conn"
            },
            "strip_path": false
        },
        "rules": {
            "jwt_token_validation": "equals",
            "path": "/",
            "path_key": "starts_with"
        }
    },
    "name": "podinfo-demo-default",
    "priority": 1,
    "profile_id": "prod",
    "rules_tags": [
        "wslproxy-demo",
        "podinfo"
    ],
    "servers": [
        "host:podinfo.pop0.uk"
    ]
}
