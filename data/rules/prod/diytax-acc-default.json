{
    "id": "diytax-acc-default",
    "match": {
        "response": {
            "backends": [
                {
                    "address": "origin-uk-001.pop0.uk",
                    "label": "origin-uk-001-traefik-edge",
                    "weight": 100
                }
            ],
            "code": 305,
            "redirect_uri": "origin-uk-001.pop0.uk",
            "routing": {
                "mode": "weighted"
            },
            "strip_path": false
        },
        "rules": {
            "path": "/",
            "path_key": "starts_with"
        }
    },
    "name": "diytax-acc-default",
    "priority": 1,
    "profile_id": "prod",
    "rules_tags": [
        "diytaxreturn",
        "acc",
        "origin-uk-002"
    ],
    "servers": [
        "host:acc.diytaxreturn.co.uk",
        "host:qa-agent-api.diytaxreturn.co.uk",
        "host:qa-agent.diytaxreturn.co.uk",
        "host:fixloop.diytaxreturn.co.uk",
        "host:app.fixloop.run"
    ]
}
