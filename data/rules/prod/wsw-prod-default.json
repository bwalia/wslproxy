{
    "id": "wsw-prod-default",
    "match": {
        "response": {
            "backends": [
                {
                    "address": "193.237.176.232:8888",
                    "label": "k3s ingress entry for *.workstation.co.uk (same backend as the working opsapi/beacon hosts); routes by Host header to the per-env wsw-frontend",
