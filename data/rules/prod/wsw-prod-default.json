                "mode": "least_conn"
            },
            "strip_path": false
        },
        "rules": {
            "path": "/",
            "path_key": "starts_with"
        }
    },
    "name": "wsw-prod-default",
    "priority": 1,
    "profile_id": "prod",
    "rules_tags": [
        "workstation-website",
        "prod"
    ],
    "servers": [
        "host:int.workstation.co.uk",
        "host:int-www.workstation.co.uk",
        "host:test-shop.workstation.co.uk",
        "host:acc-shop.workstation.co.uk"
    ]
