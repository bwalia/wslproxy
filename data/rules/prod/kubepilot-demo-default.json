{
  "id": "kubepilot-demo-default",
  "name": "kubepilot-demo-default",
  "profile_id": "prod",
  "priority": 1,
  "rules_tags": ["kubepilot", "demo"],
  "match": {
    "rules": {
      "path": "/",
      "path_key": "starts_with",
      "jwt_token_validation": "equals"
    },
    "response": {
      "strip_path": false,
      "code": 305,
      "routing": { "mode": "least_conn" },
      "backends": [
        {
          "weight": 100,
          "address": "193.237.176.232:8888",
          "label": "k3s1 traefik-edge ingress entry. Traefik routes by Host to kubepilot-demo."
        }
      ],
      "redirect_uri": "193.237.176.232:8888"
    }
  },
  "servers": [
    "host:demo.kubepilot.org"
  ]
}
