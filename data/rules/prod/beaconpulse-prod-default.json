{
    "id": "beaconpulse-prod-default",
    "match": {
        "response": {
            "backends": [
                {
                    "address": "vpnhh.workstation.co.uk:8888",
                    "label": "k3s1 traefik ingress entry (klipper) — the same target aws-k3s1-ingress-klipper-80 uses for every working wslproxy host (int.diytaxreturn.co.uk, grafana, ...). vpnhh.workstation.co.uk:8888 forwards to k3s1 traefik, which routes by Host to beacon-nginx. Verified HTTP 200. cloud003 (77.68.126.63) was a dead-end for beacon.",
                    "weight": 100
                }
            ],
            "code": 305,
            "redirect_uri": "vpnhh.workstation.co.uk:8888",
            "routing": {
                "mode": "least_conn"
            },
            "strip_path": false
        },
        "rules": {
            "jwt_token_validation": "equals",
            "path": "/",
            "path_key": "starts_with"
        }
    },
    "name": "beaconpulse-prod-default",
    "priority": 1,
    "profile_id": "prod",
    "rules_tags": [
        "beaconpulse",
        "prod"
    ],
    "servers": [
        "host:int.beaconpulse.net",
        "host:test.beaconpulse.net",
        "host:acc.beaconpulse.net",
        "host:beaconpulse.net"
    ]
}
