{
  "id": "wslproxy-org-rule",
  "created_at": 1769388395,
  "name": "wslproxy-org-github-pages",
  "profile_id": "prod",
  "priority": 1,
  "match": {
    "rules": {
      "path": "/",
      "path_key": "starts_with",
      "client_ip_key": "equals",
      "country_key": "equals",
      "jwt_token_validation": "equals"
    },
    "response": {
      "code": 305,
      "redirect_uri": "https://bwalia.github.io",
      "allow": false,
      "message": "undefined",
      "is_consul": false,
      "auto_redirect_https": false,
      "strip_path": false
    }
  },
  "version": 1,
  "_schema_version": 2,
  "servers": [
    "host:wslproxy.org"
  ]
}
