{
    "access_log": "logs/opsapi.org.access.log",
    "api_gw": {
        "audit": {
            "enabled": true,
            "include_query": false
        },
        "cors": {
            "credentials": true,
            "expose_headers": [
                "X-Correlation-ID",
                "RateLimit-Remaining"
            ],
            "headers": [
                "Authorization",
                "Content-Type",
                "X-Correlation-ID",
                "X-Namespace-Id",
                "X-Namespace-Slug"
            ],
            "max_age": 3600,
            "methods": [
                "GET",
                "POST",
                "PUT",
                "PATCH",
                "DELETE",
                "OPTIONS"
            ],
            "origins": [
                "https://opsapi.org",
                "https://sso.opsapi.org",
                "https://hello-java.fictionally.org",
                "https://hello-php.fictionally.org"
            ]
        },
        "enabled": true,
        "hooks": {
            "enabled": true,
            "lua": [
                {
                    "name": "pkce_guard",
                    "phase": "access_before",
                    "source": "return function(cfg, ctx, policy)\n    if ctx.uri ~= \"/oauth/authorize\" then return nil end\n    local a = ctx.args or {}\n    local function one(v) if type(v) == \"table\" then return v[1] end return v end\n    local challenge = one(a.code_challenge)\n    local method = one(a.code_challenge_method)\n    local ok = type(challenge) == \"string\"\n        and #challenge \u003e= 43 and #challenge \u003c= 128\n        and not challenge:find(\"[^%w%-%._~]\")\n        and method == \"S256\"\n    if ok then return nil end\n    local Response = require(\"api_gw.response\")\n    return Response.deny(400, \"invalid_request\",\n        \"PKCE required: code_challenge (43-128 chars) with code_challenge_method=S256\",\n        { module = \"hooks\" })\nend\n"
                }
            ],
            "response_headers": [
                {
                    "name": "Strict-Transport-Security",
                    "op": "set",
                    "value": "max-age=31536000; includeSubDomains"
                }
            ]
        },
        "ivt": {
            "burst": {
                "key": "ip",
                "max_requests": 200,
                "window_seconds": 10
            },
            "methods": {
                "deny": [
                    "TRACE",
                    "TRACK",
                    "CONNECT"
                ]
            },
            "mode": "audit",
            "path_denylist": [
                "/wp-admin",
                "/wp-login",
                "\\.php$",
                "/\\.env$",
                "/\\.git/"
            ],
            "strip_header_prefixes": [
                "X-Internal-"
            ]
        },
        "modules": [
            "request_security",
            "hooks",
            "cors",
            "ivt",
            "rate_limit",
            "audit"
        ],
        "rate_limit": {
            "default_profile": "standard",
            "enabled": true,
            "profiles": {
                "auth": {
                    "key": "ip",
                    "limit": 20,
                    "window_seconds": 60
                },
                "health": {
                    "limit": 0
                },
                "public": {
                    "key": "ip",
                    "limit": 300,
                    "window_seconds": 60
                },
                "standard": {
                    "key": "ip",
                    "limit": 600,
                    "window_seconds": 60
                }
            }
        },
        "request_security": {
            "correlation": {
                "enabled": true,
                "header": "X-Correlation-ID"
            },
            "max_body_bytes": 1048576
        },
        "routes": [
            {
                "name": "health",
                "path": "/health",
                "path_key": "equals",
                "rate_profile": "health"
            },
            {
                "max_body_bytes": 16384,
                "name": "login",
                "path": "/auth/",
                "path_key": "starts_with",
                "rate_profile": "auth"
            },
            {
                "methods": [
                    "GET"
                ],
                "name": "oidc-authorize",
                "path": "/oauth/authorize",
                "path_key": "equals",
                "rate_profile": "auth"
            },
            {
                "max_body_bytes": 16384,
                "methods": [
                    "POST",
                    "OPTIONS"
                ],
                "name": "oidc-token",
                "path": "/oauth/token",
                "path_key": "equals",
                "rate_profile": "auth"
            },
            {
                "cors": {
                    "credentials": false,
                    "origins": [
                        "*"
                    ]
                },
                "methods": [
                    "GET",
                    "HEAD",
                    "OPTIONS"
                ],
                "name": "oidc-discovery",
                "path": "/.well-known/",
                "path_key": "starts_with",
                "rate_profile": "public"
            },
            {
                "name": "api",
                "path": "/",
                "path_key": "starts_with",
                "rate_profile": "standard"
            }
        ]
    },
    "cache_enabled": false,
    "config_status": true,
    "custom_headers": {},
    "error_log": "logs/opsapi.org.error.log",
    "id": "host:opsapi.org",
    "listens": [
        {
            "listen": "80"
        }
    ],
    "match_cases": {},
    "pop_ids": [
        "lon1",
        "pop0"
    ],
    "profile_id": "prod",
    "proxy_server_name": "bwalia.github.io",
    "proxy_timeouts": {
        "connect_timeout": "5",
        "read_timeout": "60",
        "send_timeout": "60"
    },
    "rules": "opsapi-website-pages",
    "server_name": "opsapi.org",
    "ssl_auto_renew": true,
    "ssl_email": "admin@workstation.co.uk",
    "ssl_enabled": true,
    "ssl_force_https": true,
    "ssl_staging": false,
    "updated_at": 1793211864
}
