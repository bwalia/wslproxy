{
    "access_log": "logs/spectoncr.diytaxreturn.co.uk.access.log",
    "cache_docker_blobs": false,
    "cache_docker_blobs_ttl": "2592000",
    "cache_docker_manifests": false,
    "cache_docker_manifests_ttl": "3600",
    "cache_docker_serve_stale": false,
    "cache_docker_stale_ttl": "31536000",
    "cache_enabled": false,
    "config": "",
    "config_status": true,
    "custom_headers": {},
    "dns_cname_target": "pop1.diytaxreturn.co.uk",
    "dns_record_type": "CNAME",
    "error_log": "logs/spectoncr.diytaxreturn.co.uk.error.log",
    "id": "host:spectoncr.diytaxreturn.co.uk",
    "index": "index.html",
    "listens": [
        {
            "listen": "80"
        }
    ],
    "match_cases": {},
    "pop_ids": [
        "lon1",
        "pop0"
    ],
    "profile_id": "prod",
    "proxy_server_name": "spectoncr.diytaxreturn.co.uk",
    "proxy_timeouts": {
        "connect_timeout": "600",
        "read_timeout": "600",
        "send_timeout": "600"
    },
    "root": "/var/www/html",
    "rules": "diytax-prod-spectoncr-manchester",
    "server_name": "spectoncr.diytaxreturn.co.uk",
    "ssl_auto_renew": true,
    "ssl_email": "admin@diytaxreturn.co.uk",
    "ssl_enabled": true,
    "ssl_force_https": true,
    "ssl_staging": false
}
