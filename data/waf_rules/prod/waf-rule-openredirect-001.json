{"id":"waf-rule-openredirect-001","pattern_type":"regex","updated_at":1740000000,"severity":"medium","enabled":true,"created_at":1740000000,"target":"url","score":6,"profile_id":"prod","pattern":"(?i)[?&](?:to|url|next|redirect|return|dest|continue|goto)=(?:https?%3a|https?:|\/\/|%2f%2f)","tags":["owasp-top10","open-redirect","a01"],"action":"block","name":"Open Redirect","category":"redirect","description":"Detects open-redirect payloads where a redirect parameter points to an absolute external URL, enabling phishing and token theft."}