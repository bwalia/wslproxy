{
    "anomaly_threshold": 6,
    "blocked_response": {
        "body_base64": "",
        "content_type": "text/html",
        "status_code": 403
    },
    "body_inspection": true,
    "bruteForce": [
        {
            "action": "block",
            "keyBy": [
                "ip"
            ],
            "maxAttempts": 5,
            "path": "/api/login",
            "windowSec": 60
        }
    ],
    "created_at": 1740000000,
    "description": "F5-competitive WAF policy: OWASP Top 10 plus SSTI, Log4Shell, Spring4Shell, SSRF, NoSQLi, XXE, JWT alg:none, prototype pollution, GraphQL introspection, open redirect, HTTP request smuggling and scanner detection. Block mode.",
    "enabled": true,
    "enforcementMode": "blocking",
    "filetypes": {
        "deny": [
            ".env",
            ".sql",
            ".bak",
            ".git",
            ".ini",
            ".pem",
            ".key"
        ]
    },
    "geo": {
        "denyCountries": [
            "KP"
        ]
    },
    "id": "waf-policy-payments-hard",
    "ipLists": {
        "allow": [
            "127.0.0.1"
        ],
        "deny": {}
    },
    "jsonProfile": {
        "maxBytes": 16384,
        "maxDepth": 8
    },
    "jwt": {
        "denyAlg": [
            "none",
            "HS256"
        ],
        "header": "Authorization",
        "requireAlg": [
            "RS256",
            "ES256"
        ],
        "verifySignature": false
    },
    "logging": {
        "destination": "syslog",
        "profile": "verbose"
    },
    "max_body_size": 1048576,
    "methods": {
        "allow": [
            "GET",
            "POST",
            "HEAD",
            "OPTIONS"
        ]
    },
    "mode": "block",
    "name": "Payments API — Hardened (modern + API)",
    "openapi": {
        "basePath": "/api",
        "paths": [
            {
                "methods": [
                    "POST"
                ],
                "path": "/api/login"
            },
            {
                "methods": [
                    "GET"
                ],
                "path": "/api/accounts/{id}"
            },
            {
                "methods": [
                    "POST"
                ],
                "path": "/api/profile"
            },
            {
                "methods": [
                    "GET"
                ],
                "path": "/api/me"
            },
            {
                "methods": [
                    "POST"
                ],
                "path": "/api/import"
            },
            {
                "methods": [
                    "POST"
                ],
                "path": "/api/merge"
            },
            {
                "methods": [
                    "GET"
                ],
                "path": "/api/redirect"
            },
            {
                "methods": [
                    "POST"
                ],
                "path": "/api/batch"
            }
        ]
    },
    "paranoia_level": 2,
    "profile_id": "prod",
    "routeOverrides": [
        {
            "enforcementMode": "transparent",
            "path": "/preview"
        }
    ],
    "schema_version": 2,
    "service": "payments",
    "signatureSets": [
        {
            "alarm": true,
            "block": true,
            "id": "SET_SQLI"
        },
        {
            "alarm": true,
            "block": true,
            "id": "SET_XSS"
        },
        {
            "alarm": true,
            "block": true,
            "id": "SET_RCE"
        },
        {
            "alarm": true,
            "block": true,
            "id": "SET_SSRF"
        },
        {
            "alarm": true,
            "block": true,
            "id": "SET_SSTI"
        }
    ],
    "signatures": {
