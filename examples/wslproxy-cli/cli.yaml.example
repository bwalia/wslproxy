# Copy to ~/.config/wslproxy/cli.yaml
base_url: https://lon1.pop0.uk
profile_id: prod
output: table
auth:
  # token via WSLPROXY_TOKEN or `wslproxy-cli auth login`
  username: ""
mcp:
  api_key: ""   # or WSLPROXY_MCP_API_KEY
  write: false
inventory:
  - name: lon1
    base_url: https://lon1.pop0.uk
  - name: pop1
    base_url: https://pop1.diytaxreturn.co.uk
  - name: pop0
    base_url: https://prod-our-v1.wslproxy.com
