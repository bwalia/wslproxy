{
  "id": "podinfo-demo-default",
  "name": "podinfo-demo-default",
  "profile_id": "prod",
  "priority": 1,
  "rules_tags": ["wslproxy-demo", "podinfo"],
  "match": {
    "response": {
      "strip_path": false,
      "auto_redirect_https": false,
      "code": 305,
      "allow": true,
      "routing": {
        "mode": "least_conn"
      },
      "is_consul": false,
      "redirect_uri": "127.0.0.1:30082",
      "backends": [
        {
          "address": "127.0.0.1:30082",
          "weight": 100,
          "label": "podinfo-k3s1-nodeport"
        }
      ]
    },
    "rules": {
      "path_key": "starts_with",
      "path": "/",
      "jwt_token_validation": "equals"
    }
  },
  "servers": ["host:podinfo.pop0.uk"]
}
