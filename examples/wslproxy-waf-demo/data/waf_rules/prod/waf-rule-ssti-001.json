{
  "id": "waf-rule-ssti-001",
  "name": "SSTI - Template Expression Injection",
  "description": "Detects server-side template injection using Jinja/Twig {{...}}, {%...%}, ERB/JSP <%...%> or Ruby #{...} expression syntax.",
  "category": "ssti",
  "severity": "high",
  "enabled": true,
  "target": "all",
  "pattern": "(?:\\{\\{[^}]{0,120}?\\}\\}|\\{%[^%]{0,120}?%\\}|<%=?[^>]{0,120}?%>|#\\{[^}]{0,120}?\\})",
  "pattern_type": "regex",
  "action": "block",
  "score": 8,
  "tags": [
    "api-security",
    "ssti",
    "beyond-owasp"
  ],
  "profile_id": "prod",
  "created_at": 1740000000,
  "updated_at": 1740000000
}