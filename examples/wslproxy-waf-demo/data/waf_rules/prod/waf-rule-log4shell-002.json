{
  "id": "waf-rule-log4shell-002",
  "name": "RCE - Log4j Obfuscated Lookup",
  "description": "Detects obfuscated Log4j lookups (${lower:}, ${env:}, ${::-}, nested ${${...}}) used to evade naive jndi filters.",
  "category": "rce",
  "severity": "high",
  "enabled": true,
  "target": "all",
  "pattern": "(?i)\\$\\{(?:\\$\\{|lower:|upper:|env:|sys:|java:|date:|main:|::-)",
  "pattern_type": "regex",
  "action": "block",
  "score": 8,
  "tags": [
    "cve-2021-44228",
    "log4shell",
    "evasion"
  ],
  "profile_id": "prod",
  "created_at": 1740000000,
  "updated_at": 1740000000
}