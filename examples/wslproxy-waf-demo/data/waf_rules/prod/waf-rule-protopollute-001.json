{
  "id": "waf-rule-protopollute-001",
  "name": "Prototype Pollution",
  "description": "Detects JavaScript prototype-pollution payloads (__proto__, constructor.prototype) that mutate Object.prototype to escalate privileges.",
  "category": "proto-pollution",
  "severity": "high",
  "enabled": true,
  "target": "all",
  "pattern": "(?:__proto__|constructor\\.prototype|\\bprototype\\b\\s*\\[|\\\"constructor\\\"\\s*:)",
  "pattern_type": "regex",
  "action": "block",
  "score": 8,
  "tags": [
    "api-security",
    "prototype-pollution",
    "beyond-owasp"
  ],
  "profile_id": "prod",
  "created_at": 1740000000,
