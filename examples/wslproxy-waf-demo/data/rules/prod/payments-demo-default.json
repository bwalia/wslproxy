{
  "id": "payments-demo-default",
  "name": "payments-demo-default",
  "profile_id": "prod",
  "priority": 1,
  "rules_tags": ["wslproxy-waf-demo", "payments"],
  "match": {
    "response": {
      "strip_path": false,
      "auto_redirect_https": false,
      "code": 305,
      "allow": true,
      "routing": { "mode": "least_conn" },
      "is_consul": false,
      "redirect_uri": "origin-uk-001.pop0.uk:30084",
      "backends": [
        { "address": "origin-uk-001.pop0.uk:30084", "weight": 100, "label": "payments-api-k3s1-nodeport" }
      ]
    },
    "rules": { "path_key": "starts_with", "path": "/", "jwt_token_validation": "equals" }
  },
  "servers": ["host:payments.fictionally.org", "host:payments-open.fictionally.org", "host:payments-secure.fictionally.org"]
}
