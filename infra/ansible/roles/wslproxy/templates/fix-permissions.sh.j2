#!/bin/bash

set -x

  mkdir -p "/var/run/nginx/" \
    && chmod +x "/var/run/nginx/" \
    && chown www-data:root "/var/run/nginx/" \
    && chmod 755 -R "/var/run/nginx/"

mkdir -p "/tmp/nginx/" \
    && chmod +x "/tmp/nginx/" \
    && chown www-data:root "/tmp/nginx/" \
    && chmod 777 -R "/tmp/nginx/"

touch /var/run/nginx/nginx-reboot.log
chmod 777 /var/run/nginx/nginx-reboot.log

mkdir -p /opt/nginx/conf.d \
    && chmod 775 /opt/nginx/conf.d \
    && chown www-data:root /opt/nginx/conf.d

chmod 775 -R /usr/local/openresty/nginx/logs/ \
    && chown -R www-data:root /usr/local/openresty/nginx/logs/

chmod 775 -R /usr/local/openresty/nginx/conf/ \
    && chown -R www-data:root /usr/local/openresty/nginx/conf/

# Fix main nginx directory permissions for www-data user
chmod 775 /usr/local/openresty/nginx/ \
    && chown www-data:root /usr/local/openresty/nginx/

# Fix sbin directory permissions so www-data can execute openresty commands
chmod 755 -R /usr/local/openresty/nginx/sbin/ \
    && chown -R www-data:root /usr/local/openresty/nginx/sbin/

# Ensure PID file has correct permissions if it exists
if [ -f "/usr/local/openresty/nginx/logs/nginx.pid" ]; then
    chmod 644 /usr/local/openresty/nginx/logs/nginx.pid
    chown www-data:root /usr/local/openresty/nginx/logs/nginx.pid
fi

chmod -R 777 /opt/nginx/data/ \
    && chown -R www-data:root /opt/nginx/data/

# Create SSL config directory for Let's Encrypt certificate management
mkdir -p /opt/nginx/data/ssl/ \
    && chmod 775 -R /opt/nginx/data/ssl/ \
    && chown -R www-data:root /opt/nginx/data/ssl/

# Create SSL certificates storage directory for lua-resty-auto-ssl
mkdir -p /opt/nginx/data/ssl-certs/ \
    && mkdir -p /opt/nginx/data/ssl-certs/storage/file/ \
    && mkdir -p /opt/nginx/data/ssl-certs/letsencrypt/ \
    && mkdir -p /opt/nginx/data/ssl-certs/letsencrypt/.acme-challenges/ \
    && mkdir -p /opt/nginx/data/ssl-certs/letsencrypt/conf.d/ \
    && chmod 777 -R /opt/nginx/data/ssl-certs/ \
    && chown -R www-data:root /opt/nginx/data/ssl-certs/

# Create upstreams directory for dynamic upstream configurations
mkdir -p /opt/nginx/data/upstreams/prod/ \
    && chmod 775 -R /opt/nginx/data/upstreams/ \
    && chown -R www-data:root /opt/nginx/data/upstreams/

# Create empty upstreams.conf if it doesn't exist to prevent nginx include errors
touch /opt/nginx/data/upstreams/prod/upstreams.conf \
    && chmod 664 /opt/nginx/data/upstreams/prod/upstreams.conf \
    && chown www-data:root /opt/nginx/data/upstreams/prod/upstreams.conf

# Create WAF rules and policies directories
mkdir -p /opt/nginx/data/waf_rules/prod/ \
    && chmod 775 -R /opt/nginx/data/waf_rules/ \
    && chown -R www-data:root /opt/nginx/data/waf_rules/

mkdir -p /opt/nginx/data/waf_policies/prod/ \
    && chmod 775 -R /opt/nginx/data/waf_policies/ \
    && chown -R www-data:root /opt/nginx/data/waf_policies/

# Create /var/log/nginx directory for access/error logs
mkdir -p /var/log/nginx/ \
    && chmod 775 -R /var/log/nginx/ \
    && chown -R www-data:root /var/log/nginx/

# Generate self-signed fallback SSL certs if they don't exist (required for nginx startup)
if [ ! -f /etc/ssl/resty-auto-ssl-fallback.crt ]; then
    openssl req -new -newkey rsa:2048 -days 3650 -nodes -x509 \
        -subj '/CN=sni-support-required-for-valid-ssl' \
        -keyout /etc/ssl/resty-auto-ssl-fallback.key \
        -out /etc/ssl/resty-auto-ssl-fallback.crt 2>/dev/null
    chmod 644 /etc/ssl/resty-auto-ssl-fallback.crt
    chmod 600 /etc/ssl/resty-auto-ssl-fallback.key
fi

mkdir -p /opt/nginx/prod_cache/
chmod 775 -R /opt/nginx/prod_cache/
chown www-data:root -R /opt/nginx/prod_cache/

mkdir -p /var/cache/nginx/docker_blobs
chmod 775 -R /var/cache/nginx/docker_blobs
chown www-data:root -R /var/cache/nginx/docker_blobs

if [ -f "/tmp/.env" ]; then
  cp /tmp/.env /usr/local/openresty/nginx/html/openresty-admin/.env
fi
