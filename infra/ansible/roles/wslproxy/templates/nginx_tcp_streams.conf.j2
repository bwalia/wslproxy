{# Managed by Ansible (roles/wslproxy) — rendered to /opt/nginx/base.d/          #}
{# nginx_tcp_streams.conf and included via /opt/nginx/base.d/*.conf              #}
{# (see roles/wslproxy/templates/nginx.conf.j2). nginx allows a SINGLE stream{} #}
{# context, so every TCP passthrough LB lives in this one block.                #}
stream {
    # k3s0 (home) API passthrough LB — served on every openresty pop.
    upstream str_k3s0_api_9443 {
        least_conn;
        server 192.168.1.124:9443 weight=1 max_fails=3 fail_timeout=10s;
        server 192.168.1.138:9443 weight=1 max_fails=3 fail_timeout=10s;
#        server 192.168.1.121:9443 weight=1 max_fails=3 fail_timeout=10s;
    }
    server {
        listen 9443;
        proxy_pass str_k3s0_api_9443;
        proxy_timeout 10m;
        proxy_connect_timeout 1m;
    }
{% if k3s1api_lb_listen is defined %}

    # k3s1 (AWS) API failover LB for https://k3s1api.diytaxreturn.co.uk:6443 —
    # raw TCP passthrough to the k3s1 control-plane API servers over the
    # WireGuard mesh (TLS terminates at k3s; its serving cert carries the
    # k3s1api SAN). Rendered ONLY on the pop whose host_vars sets
    # k3s1api_lb_listen (pop1 / ip-10-0-0-207): k3s there binds :6443 on the
    # mesh IP + loopback only, leaving the ENI IP free for this listener (the
    # public EIP NATs to it). Managed in diy-tax-return-infra's
    # clusters/k3s/bootstrap/k3s1api-lb.sh historically; codified here so the
    # prod deploy owns it. Re-point k3s1api DNS at this pop's EIP for failover.
    upstream str_k3s1_api_6443 {
        least_conn;
{% for s in k3s1api_lb_upstreams %}
        server {{ s }} max_fails=3 fail_timeout=10s;
{% endfor %}
    }
    server {
        listen {{ k3s1api_lb_listen }};
        proxy_pass str_k3s1_api_6443;
        proxy_timeout 10m;
        proxy_connect_timeout 1m;
    }
{% endif %}
}
