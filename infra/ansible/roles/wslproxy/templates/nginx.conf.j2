# source: infra/ansible/roles/luarocks/templates/nginx.conf.j2
user  www-data;
worker_processes  1;

error_log  logs/error.log;
#error_log  logs/error.log  notice;
#error_log  logs/error.log  info;

pid        logs/nginx.pid;

events {
    worker_connections  1024;
}

env DNS_RESOLVER;
env REDIS_HOST;
env HOSTNAME;
env APP_NAME;
env LUA_DEBUG;
env VERSION;
env STACK;
env VITE_DEPLOYMENT_TIME;
env NGINX_CONFIG_DIR;
env JWT_SECURITY_PASSPHRASE;
env CONTROL_PLANE_API_URL;
env PRIMARY_DNS_RESOLVER;
env SECONDARY_DNS_RESOLVER;
env DNS_RESOLVER_PORT;
env FRONT_URL;
env AWS_ACCESS_KEY_ID;
env AWS_SECRET_ACCESS_KEY;
env AWS_REGION;
env SSL_STAGING;
env MCP_ENABLED;
env MCP_MODE;
env MCP_API_KEY;
env MCP_TOOLS_ENABLED;
env VARNISH_ENABLED;

{% if target_env == 'prod' %}
# TCP stream proxy configs (only on production proxy hosts)
include /opt/nginx/base.d/*.conf;
{% endif %}

http {

    server_names_hash_bucket_size 1024;
    server_names_hash_max_size 1024;

    include       mime.types;
    default_type  application/octet-stream;

    log_format  main  '$remote_addr - $remote_user [$time_local] '
                             '"$request" $status $body_bytes_sent '
                             '"$http_referer" "$http_user_agent" '
                             '$request_time $host';

    # Log format with geographic country code
    log_format  main_geo  '$remote_addr ($geo_country) - $remote_user [$time_local] '
                             '"$request" $status $body_bytes_sent '
                             '"$http_referer" "$http_user_agent" '
                             '$request_time $host';

    access_log /usr/local/openresty/nginx/logs/access.log main;
    error_log /usr/local/openresty/nginx/logs/error.log notice;

    server_tokens off;
    more_set_headers 'Server: wslproxy/1.0.1';

    sendfile        on;
    #tcp_nopush     on;

    #keepalive_timeout  0;
    keepalive_timeout  65;

    gzip  on;
    lua_package_path "/usr/local/openresty/nginx/html/api/?.lua;/usr/local/openresty/nginx/html/api/?/init.lua;/usr/local/openresty/lualib/?.lua;/usr/local/openresty/site/lualib/?.lua;/usr/local/openresty/luajit/share/lua/5.1/?.lua;/usr/local/openresty/luajit/share/lua/5.1/?/init.lua;/usr/local/share/lua/5.1/?.lua;/usr/local/share/lua/5.1/?/init.lua;;";
    lua_package_cpath '/usr/local/openresty/site/lualib/resty/?.so;/usr/local/openresty/lualib/?.so;/usr/local/openresty/luajit/lib/lua/5.1/?.so;/usr/local/lib/lua/5.1/?.so;;';

    # Include dynamic upstream configurations
    include /opt/nginx/data/upstreams/*/upstreams.conf;

   # Storage for challenge token and cert cache

    lua_shared_dict auto_ssl 100m;
    lua_shared_dict auto_ssl_settings 64k;

    # SSL domains cache - shared across all workers for allow_domain callback
    lua_shared_dict ssl_domains 1m;

    # Static content cache (WSL Proxy caching system)
    lua_shared_dict wsl_cache 100m;
    lua_shared_dict wsl_cache_keys 10m;

    # Docker blob disk cache (content-addressable, immutable layers)
    proxy_cache_path /var/cache/nginx/docker_blobs levels=1:2
                     keys_zone=docker_blobs_cache:20m
                     max_size=10g inactive=30d
                     use_temp_path=off;

    # Prometheus metrics storage (increased from 50M to handle high-cardinality metrics)
    lua_shared_dict prometheus_metrics 150M;
    lua_shared_dict healthcheck 1m;

    # Traffic stats for dashboard (stores hourly request/response counts)
    lua_shared_dict traffic_stats 5m;

    # WAF event log storage (stores recent WAF events for dashboard and API)
    lua_shared_dict waf_events 10m;

    # Traffic router state (backend health, round-robin counters, sticky sessions, per-backend stats)
    lua_shared_dict router_state 5m;

    # Varnish deployment state (deploy status, VCL labels per server)
    lua_shared_dict varnish_state 2m;

    geo $limit {
        default 1;
        10.0.0.0/8 0;
        192.168.0.0/24 0;
    }

    map $limit $limit_key {
        0 "";
        1 $binary_remote_addr;
    }

    # WebSocket support: map Upgrade header to Connection header value
    map $http_upgrade $connection_upgrade {
      default upgrade;
      ''      '';
    }

    limit_req_zone $limit_key zone=req_zone:10m rate=100r/s;
    limit_req_zone $binary_remote_addr zone=req_zone_wl:10m rate=200r/s;

    # Also add burst allowance to handle initial page loads
    limit_req zone=req_zone burst=90 nodelay;

    init_by_lua_file /usr/local/openresty/nginx/html/api/init.lua;

    init_worker_by_lua_block {
        -- Initialize Prometheus metrics (requires lua_code_cache to be ON)
        local ok, metrics = pcall(require, "prometheus_metrics")
        if ok then
            metrics.init()
        else
            ngx.log(ngx.WARN, "Prometheus metrics module not available: ", tostring(metrics))
        end

        -- Initialize log interceptor for tracking log level metrics
        local log_int_ok, log_interceptor = pcall(require, "log_interceptor")
        if log_int_ok then
            log_interceptor.init()
        else
            ngx.log(ngx.WARN, "log_interceptor module not available: ", tostring(log_interceptor))
        end

        -- Initialize upstream health checks
        local hc_init_ok, hc_init = pcall(require, "healthcheck_init")
        if hc_init_ok then
            hc_init.init()
        else
            ngx.log(ngx.WARN, "healthcheck_init module not available: ", tostring(hc_init))
        end

        -- Initialize traffic router health checks
        local tr_ok, tr = pcall(require, "traffic_router")
        if tr_ok and tr.start_health_checks then
            tr.start_health_checks()
        else
            ngx.log(ngx.WARN, "traffic_router module not available: ", tostring(tr))
        end

        -- Initialize SSL domains cache from Redis (cosockets work in init_worker context)
        local ssl_init_ok, ssl_init = pcall(require, "ssl_init")
        if ssl_init_ok then
            ssl_init.init()
        else
            ngx.log(ngx.WARN, "ssl_init module not available: ", tostring(ssl_init))
        end
    }

    log_by_lua_block {
        local ok, log_handler = pcall(require, "log_handler")
        if ok and log_handler then
            log_handler.log_request()
        end
    }

    # global_backend
    upstream global_backend {
    server 0.0.0.1:1000 max_fails=3 fail_timeout=5s;

    balancer_by_lua_block {
    local balancer = require "ngx.balancer"
    local host = ngx.var.proxy_host
    local port = ngx.var.proxy_port

    -- Retry support: if this is a retry attempt, pick a different backend
    local retry_count = ngx.ctx._balancer_retry_count or 0
    if retry_count > 0 and ngx.ctx._router_response_cache then
        local tr_ok, TrafficRouter = pcall(require, "traffic_router")
        if tr_ok and TrafficRouter then
            local failed_addr = ngx.ctx._balancer_failed_addr
            local response = ngx.ctx._router_response_cache
            local ctx = ngx.ctx._router_ctx_cache or {}
            local new_backend = TrafficRouter.select_backend(response, ctx, { exclude = failed_addr })
            if new_backend then
                local addr = new_backend.address or ""
                addr = addr:gsub("^https?://", "")
                local new_host = addr:match("^(.-):")
                local new_port = addr:match(":(%d+)$")
                if new_host and new_port then
                    host = new_host
                    port = new_port
                    ngx.ctx.selected_backend_label = new_backend.label
                    ngx.log(ngx.WARN, "balancer: retrying with backend ", host, ":", port,
                        " after failure on ", tostring(failed_addr))
                end
            end
        end
    end

    local ok, err = balancer.set_current_peer(host, port)
    if not ok then
        ngx.log(ngx.ERR, "balancer.set_current_peer failed to set the host " .. host .. ":" .. port .. " current peer: ", err)
        return ngx.exit(500)
    end

    -- Enable retries for multi-backend rules (up to 2 retries)
    if retry_count == 0 and ngx.ctx._router_response_cache then
        local max_retries = 2
        local response = ngx.ctx._router_response_cache
        if response.backends and #response.backends > 1 then
            balancer.set_more_tries(math.min(max_retries, #response.backends - 1))
        end
    end

    -- Track retry state
    ngx.ctx._balancer_retry_count = retry_count + 1
    ngx.ctx._balancer_failed_addr = host .. ":" .. port

    -- Per-server proxy timeouts (set by gateway_resp.lua via ngx.ctx)
    local pt = ngx.ctx.proxy_timeouts
    if pt and balancer.set_timeouts then
        local ct = pt.connect_timeout or 60
        local st = pt.send_timeout or 60
        local rt = pt.read_timeout or 60
        local tok, terr = pcall(balancer.set_timeouts, ct, st, rt)
        if not tok then
            ngx.log(ngx.ERR, "balancer.set_timeouts failed: ", terr)
        end
    end
    }

    keepalive 10; # connection pool
    }
    # global_backend ends

    # Health check server - always available
    server {
        listen       {{ nginx_default_server_backend_port }};
        server_name  127.0.0.1;

      location /ping {
          default_type 'application/json';
          more_set_headers 'Access-Control-Allow-Origin: *';
          content_by_lua_block {
              local cjson = require("cjson")
              local configPath = os.getenv("NGINX_CONFIG_DIR") or "/opt/nginx/"

              -- Read settings.json for storage_type and env vars
              local settings = {}
              local settingsFile = io.open(configPath .. "data/settings.json", "rb")
              if settingsFile then
                  local ok, decoded = pcall(cjson.decode, settingsFile:read("*a"))
                  settingsFile:close()
                  if ok then settings = decoded end
              end
              if not settings.env_vars then settings.env_vars = {} end

              local storageType = settings.storage_type or os.getenv("STORAGE_TYPE") or "disk"
              local dbStatusMsg = "No Database Selected"
              if storageType == "redis" then
                  local ok, redis = pcall(require, "resty.redis")
                  if ok then
                      local red = redis:new()
                      red:set_timeouts(1000, 1000, 1000)
                      local host = settings.env_vars.REDIS_HOST or os.getenv("REDIS_HOST") or "localhost"
                      local port = settings.env_vars.REDIS_PORT or os.getenv("REDIS_PORT") or 6379
                      local conn_ok = red:connect(host, port)
                      dbStatusMsg = conn_ok and "OK" or "Failed to connect"
                  end
              end

              -- Read OpenResty version
              local versionFile = io.open("/opt/nginx/VERSION", "r")
              local version = versionFile and versionFile:read("*a") or "unknown"
              if versionFile then versionFile:close() end

              local data = {
                  response = "pong",
                  app = settings.env_vars.APP_NAME or os.getenv("APP_NAME") or "wslproxy",
                  version = settings.env_vars.VERSION or os.getenv("VERSION") or "unknown",
                  hostname = settings.env_vars.HOSTNAME or os.getenv("HOSTNAME") or "unknown",
                  openresty_version = version,
                  redis_status_msg = dbStatusMsg,
                  storage_type = storageType,
                  node_uptime = os.date("%Y-%m-%d %H:%M:%S"),
                  pod_uptime = "0 days",
                  mendatory_env_vars_backend = {
                      NGINX_CONFIG_DIR = configPath and "Found" or "Not Found",
                      JWT_SECURITY_PASSPHRASE = (settings.env_vars.JWT_SECURITY_PASSPHRASE or os.getenv("JWT_SECURITY_PASSPHRASE")) and "Found" or "Not Found",
                      PRIMARY_DNS_RESOLVER = (settings.env_vars.PRIMARY_DNS_RESOLVER or os.getenv("PRIMARY_DNS_RESOLVER")) and "Found" or "Not Found",
                      SECONDARY_DNS_RESOLVER = (settings.env_vars.SECONDARY_DNS_RESOLVER or os.getenv("SECONDARY_DNS_RESOLVER")) and "Found" or "Not Found",
                      DNS_RESOLVER_PORT = (settings.env_vars.DNS_RESOLVER_PORT or os.getenv("DNS_RESOLVER_PORT")) and "Found" or "Not Found",
                  }
              }
              ngx.header.content_type = "application/json"
              ngx.say(cjson.encode(data))
          }
      }

      location /health {
          default_type 'application/json';
          more_set_headers 'Access-Control-Allow-Origin: *';
          content_by_lua_file /usr/local/openresty/nginx/html/api/ping.lua;
      }

      location /ready {
          default_type 'application/json';
          more_set_headers 'Access-Control-Allow-Origin: *';
          content_by_lua_file /usr/local/openresty/nginx/html/api/ready.lua;
      }

{% if nginx_web_ui_enabled is defined and nginx_web_ui_enabled == "yes" %}
        # Openresty Admin UI
        error_page  403              /403.html;
        error_page  404              /404.html;
        error_page  500 502 503 504  /50x.html;

        location = /403.html { root html; internal; }
        location = /404.html { root html; internal; }
        location = /50x.html { root html; internal; }

        location / {
          root   /usr/local/openresty/nginx/html/openresty-admin/dist;
          index  index.html index.htm;
        }

        client_max_body_size  0;
        client_body_buffer_size 128k;

        location ~ ^/api(.*)$ {
            default_type 'text/plain';
            more_set_headers 'Access-Control-Allow-Methods: GET, POST, PUT, DELETE, OPTIONS';
            more_set_headers 'Access-Control-Allow-Headers: Content-Type';
            access_by_lua_block {
                local cjson = Cjson
                local path_name = ngx.var.uri:match("^/api/(.*)$")
                if path_name ~= "user/login"
                    and path_name ~= "user/logout"
                    and path_name ~= "topology/graph" then
                    local jwt = require "resty.jwt"
                    -- Accept either Authorization: Bearer (react-admin) or
                    -- the httpOnly `wslproxy_token` cookie (openresty-admin-next).
                    local token = ngx.req.get_headers()["Authorization"]
                    if token then
                        token = string.gsub(token, "^Bearer ", "")
                    else
                        token = ngx.var.cookie_wslproxy_token
                    end
                    if not token or token == "" then
                        ngx.status = ngx.HTTP_UNAUTHORIZED
                        ngx.header["Access-Control-Allow-Origin"] = "*"
                        ngx.say("Missing token")
                        return ngx.exit(ngx.HTTP_UNAUTHORIZED)
                    end
                    local function getSettings()
                      local configPath = os.getenv("NGINX_CONFIG_DIR") or "/opt/nginx/"
                      local readSettings, errSettings = io.open(configPath .. "data/settings.json", "rb")
                      local settings = {}
                      if readSettings == nil then
                          ngx.say("Couldn't read file: " .. errSettings)
                      else
                          local jsonString = readSettings:read "*a"
                          readSettings:close()
                          settings = cjson.decode(jsonString)
                      end
                      return settings
                    end
                    local settings = getSettings()
                    if settings and type(settings) == "table" then
                      local passPhrase = settings.env_vars.JWT_SECURITY_PASSPHRASE or os.getenv("JWT_SECURITY_PASSPHRASE")
                      if not passPhrase or passPhrase == "" then
                        ngx.status = ngx.HTTP_UNAUTHORIZED
                        ngx.header["Access-Control-Allow-Origin"] = "*"
                        ngx.say(cjson.encode({data = {message = "JWT Pass Phrase is missing"}}))
                        return ngx.exit(ngx.HTTP_UNAUTHORIZED)
                      end
                      local verified_token = jwt:verify(passPhrase, token)
                      if verified_token.verified == false then
                          ngx.status = ngx.HTTP_UNAUTHORIZED
                          ngx.header["Access-Control-Allow-Origin"] = "*"
                          ngx.say(cjson.encode({data = {message = verified_token.reason}}))
                          return ngx.exit(ngx.HTTP_UNAUTHORIZED)
                      end
                    else
                      ngx.status = ngx.HTTP_UNAUTHORIZED
                      ngx.header["Access-Control-Allow-Origin"] = "*"
                      ngx.say(cjson.encode({data = {message = "Settings Json file missing, Please make sure you have correctly placed the setting json file while initlising the project."}}))
                      return ngx.exit(ngx.HTTP_UNAUTHORIZED)
                    end
                end
            }
            
            if ($request_method = 'OPTIONS') {
                more_set_headers 'Access-Control-Allow-Origin: *';
                more_set_headers 'Access-Control-Allow-Methods: GET, POST, OPTIONS, PUT, DELETE';
                more_set_headers 'Access-Control-Allow-Headers: Authorization, Content-Type, X-Requested-With';
                more_set_headers 'Access-Control-Max-Age: 1728069';
                more_set_headers 'Content-Type: text/plain; charset=utf-8';
                return 204;
            }

            content_by_lua_file /usr/local/openresty/nginx/html/api/api.lua; # < Points to Lua file
        }

        location /swagger {
          root   html;
          index  swagger.html swagger.htm;
        }

        # MCP (Model Context Protocol) Server Endpoints
        # Provides AI-agent accessible interface to WSLProxy configuration and status
        location ~ ^/mcp(/.*)?$ {
            default_type 'application/json';
            more_set_headers 'Access-Control-Allow-Origin: *';
            more_set_headers 'Access-Control-Allow-Methods: GET, POST, OPTIONS';
            more_set_headers 'Access-Control-Allow-Headers: Authorization, Content-Type, X-MCP-API-Key';
            more_set_headers 'Access-Control-Max-Age: 1728069';

            if ($request_method = 'OPTIONS') {
                more_set_headers 'Access-Control-Allow-Origin: *';
                more_set_headers 'Access-Control-Allow-Methods: GET, POST, OPTIONS';
                more_set_headers 'Access-Control-Allow-Headers: Authorization, Content-Type, X-MCP-API-Key';
                more_set_headers 'Access-Control-Max-Age: 1728069';
                more_set_headers 'Content-Type: text/plain; charset=utf-8';
                return 204;
            }

            content_by_lua_block {
                local ok, handler = pcall(require, "mcp.handler")
                if ok then
                    handler.route()
                else
                    ngx.status = ngx.HTTP_INTERNAL_SERVER_ERROR
                    ngx.header.content_type = "application/json"
                    ngx.say(require("cjson").encode({
                        error = {
                            code = 500,
                            message = "MCP handler failed to load: " .. tostring(handler),
                            type = "internal_error"
                        }
                    }))
                end
            }
        }

        # Prometheus Metrics Endpoint
        location /metrics {
            # Restrict access to internal networks and trusted IPs
            allow 127.0.0.1;
            allow ::1;
            allow 10.0.0.0/8;
            allow 172.16.0.0/12;
            allow 192.168.0.0/16;
            allow 172.71.0.0/16;
            # Office/Trusted external IPs
            allow 193.237.176.232;
            deny all;

            content_by_lua_block {
                local ok, metrics = pcall(require, "prometheus_metrics")
                if ok then
                    local metric_connections = metrics.get_metric_connections()
                    local prometheus = metrics.get_prometheus()
                    if metric_connections and prometheus then
                        metric_connections:set(ngx.var.connections_reading, {"reading"})
                        metric_connections:set(ngx.var.connections_waiting, {"waiting"})
                        metric_connections:set(ngx.var.connections_writing, {"writing"})
                        prometheus:collect()
                    else
                        ngx.status = 503
                        ngx.header.content_type = "text/plain"
                        ngx.say("# ERROR: Prometheus metrics not initialized")
                        ngx.say("# Possible causes:")
                        ngx.say("#   - metrics.init() was not called in init_worker_by_lua_block")
                        ngx.say("#   - lua_shared_dict prometheus_metrics is not configured")
                    end
                else
                    ngx.log(ngx.ERR, "Failed to load prometheus_metrics module: ", tostring(metrics))
                    ngx.status = 503
                    ngx.header.content_type = "text/plain"
                    ngx.say("# ERROR: Failed to load prometheus_metrics module")
                    ngx.say("# Reason: " .. tostring(metrics))
                    ngx.say("# Possible causes:")
                    ngx.say("#   - prometheus_metrics.lua file is missing from api/ directory")
                    ngx.say("#   - lua_package_path does not include the api directory")
                end
            }
        }

        # Nginx Status Endpoint (for nginx_exporter)
        location /nginx_status {
            stub_status;
            allow 127.0.0.1;
            allow ::1;
            allow 10.0.0.0/8;
            allow 172.16.0.0/12;
            allow 192.168.0.0/16;
            allow 172.71.0.0/16;
            # Office/Trusted external IPs
            allow 193.237.176.232;
            deny all;
        }

        # Upstream Health Check Status Endpoint
        location /upstream_status {
            allow 127.0.0.1;
            allow ::1;
            allow 10.0.0.0/8;
            allow 172.16.0.0/12;
            allow 192.168.0.0/16;
            allow 172.71.0.0/16;
            deny all;

            default_type text/plain;
            content_by_lua_block {
                local hc = require "resty.upstream.healthcheck"
                ngx.say("Upstream Health Check Status")
                ngx.say("============================")
                ngx.print(hc.status_page())
            }
        }
{% endif %}
    }

{% if nginx_web_ui_enabled is defined and nginx_web_ui_enabled == "yes" %}
    # ── Next.js Admin Dashboard (port {{ nginx_nextjs_dashboard_port }}) ──────────────
    # Reverse proxies to the Next.js standalone Node.js server on port {{ nginx_nextjs_node_port }}
    # API/health/ping endpoints are handled by OpenResty Lua directly (same as port {{ nginx_default_server_backend_port }})
    # Runs alongside the legacy React-Admin dashboard on port {{ nginx_default_server_backend_port }}
    server {
        listen       {{ nginx_nextjs_dashboard_port }};
        server_name  127.0.0.1 localhost;

        client_max_body_size  0;
        client_body_buffer_size 128k;

        # Health and ping — served by OpenResty Lua (same as legacy dashboard)
        location /health {
            default_type 'application/json';
            more_set_headers 'Access-Control-Allow-Origin: *';
            more_set_headers 'Access-Control-Allow-Methods: GET';
            more_set_headers 'Access-Control-Allow-Headers: Authorization, Content-Type, X-Requested-With';
            content_by_lua_file /usr/local/openresty/nginx/html/api/ping.lua;
        }

        location /ping {
            default_type 'application/json';
            content_by_lua_file /usr/local/openresty/nginx/html/api/ping.lua;
        }

        # API — identical auth + Lua handler as the main {{ nginx_default_server_backend_port }} block
        location ~ ^/api(.*)$ {
            default_type 'text/plain';
            more_set_headers 'Access-Control-Allow-Methods: GET, POST, PUT, DELETE, OPTIONS';
            more_set_headers 'Access-Control-Allow-Headers: Authorization, Content-Type, X-Requested-With';
            access_by_lua_block {
                local cjson = Cjson
                local path_name = ngx.var.uri:match("^/api/(.*)$")
                if path_name ~= "user/login"
                    and path_name ~= "user/logout"
                    and path_name ~= "topology/graph" then
                    local jwt = require "resty.jwt"
                    -- Accept either Authorization: Bearer (react-admin) or
                    -- the httpOnly `wslproxy_token` cookie (openresty-admin-next).
                    local token = ngx.req.get_headers()["Authorization"]
                    if token then
                        token = string.gsub(token, "^Bearer ", "")
                    else
                        token = ngx.var.cookie_wslproxy_token
                    end
                    if not token or token == "" then
                        ngx.status = ngx.HTTP_UNAUTHORIZED
                        ngx.header["Access-Control-Allow-Origin"] = "*"
                        ngx.say("Missing token")
                        return ngx.exit(ngx.HTTP_UNAUTHORIZED)
                    end
                    local function getSettings()
                      local configPath = os.getenv("NGINX_CONFIG_DIR") or "/opt/nginx/"
                      local readSettings, errSettings = io.open(configPath .. "data/settings.json", "rb")
                      local settings = {}
                      if readSettings == nil then
                          ngx.say("Couldn't read file: " .. errSettings)
                      else
                          local jsonString = readSettings:read "*a"
                          readSettings:close()
                          settings = cjson.decode(jsonString)
                      end
                      return settings
                    end
                    local settings = getSettings()
                    if settings and type(settings) == "table" then
                      local passPhrase = settings.env_vars.JWT_SECURITY_PASSPHRASE or os.getenv("JWT_SECURITY_PASSPHRASE")
                      if not passPhrase or passPhrase == "" then
                        ngx.status = ngx.HTTP_UNAUTHORIZED
                        ngx.header["Access-Control-Allow-Origin"] = "*"
                        ngx.say(cjson.encode({data = {message = "JWT Pass Phrase is missing"}}))
                        return ngx.exit(ngx.HTTP_UNAUTHORIZED)
                      end
                      local verified_token = jwt:verify(passPhrase, token)
                      if verified_token.verified == false then
                          ngx.status = ngx.HTTP_UNAUTHORIZED
                          ngx.header["Access-Control-Allow-Origin"] = "*"
                          ngx.say(cjson.encode({data = {message = verified_token.reason}}))
                          return ngx.exit(ngx.HTTP_UNAUTHORIZED)
                      end
                    else
                      ngx.status = ngx.HTTP_UNAUTHORIZED
                      ngx.header["Access-Control-Allow-Origin"] = "*"
                      ngx.say(cjson.encode({data = {message = "Settings Json file missing, Please make sure you have correctly placed the setting json file while initlising the project."}}))
                      return ngx.exit(ngx.HTTP_UNAUTHORIZED)
                    end
                end
            }

            if ($request_method = 'OPTIONS') {
                more_set_headers 'Access-Control-Allow-Origin: *';
                more_set_headers 'Access-Control-Allow-Methods: GET, POST, OPTIONS, PUT, DELETE';
                more_set_headers 'Access-Control-Allow-Headers: Authorization, Content-Type, X-Requested-With';
                more_set_headers 'Access-Control-Max-Age: 1728069';
                more_set_headers 'Content-Type: text/plain; charset=utf-8';
                return 204;
            }

            content_by_lua_file /usr/local/openresty/nginx/html/api/api.lua;
        }

        location /swagger {
          root   html;
          index  swagger.html swagger.htm;
        }

        # All other requests — proxy to Next.js standalone Node.js server
        location / {
            proxy_pass http://127.0.0.1:{{ nginx_nextjs_node_port }};
            proxy_http_version 1.1;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection 'upgrade';
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_cache_bypass $http_upgrade;
        }

        error_page  403              /403.html;
        error_page  404              /404.html;
        error_page  500 502 503 504  /50x.html;

        location = /403.html { root html; internal; }
        location = /404.html { root html; internal; }
        location = /50x.html { root html; internal; }
    }
