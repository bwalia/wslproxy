        ssl_prefer_server_ciphers off;

        ssl_certificate_by_lua_block {
          auto_ssl:ssl_certificate()
        }

        ssl_certificate /etc/ssl/resty-auto-ssl-fallback.crt;
        ssl_certificate_key /etc/ssl/resty-auto-ssl-fallback.key;

        more_set_headers 'Strict-Transport-Security: max-age=31536000; includeSubDomains';

        limit_req zone=req_zone burst=90 nodelay;
        limit_req zone=req_zone_wl burst=200 nodelay;

        # Allow any size file to be uploaded (needed for Docker registry, large file uploads, etc.)
        client_max_body_size 0;
        proxy_buffering off;
        proxy_request_buffering off;

        # resolver 127.0.0.1 local=on;
        # include /tmp/resolver.conf;         #   For docker / kubernetes use 10.43.0.10 and nginx ingress controller (not for native installation)

          # define shared variables between lua and nginx lua balancer;
          set $proxy_host "";
          set $proxy_port "";
          set $proxy_host_scheme "http";

          set $proxy_host_override "";
          set $proxy_route_server "openresty-default-route-443";
          set $upstream_server "global_backend";

          # Docker blob cache zone variable (set by Lua when Docker blob caching is enabled)
          set $docker_cache_zone "";
          set $docker_cache_stale "";

          # Geo country code variable for logging
          set $geo_country "-";
          set_by_lua_block $geo_country {
            local ok, geo = pcall(require, "geo_lookup")
            if ok then
              return geo.get_country(ngx.var.remote_addr)
            end
            return "-"
          }

          # ACME Challenge for Let's Encrypt (lua-resty-auto-ssl)
          location /.well-known/acme-challenge/ {
            content_by_lua_block {
              auto_ssl:challenge_server()
            }
          }

          location / {
          access_log /var/log/nginx/access.log main_geo;
          error_log  /var/log/nginx/error.log;
          # access_log  on;
          # error_log on;

            default_type text/plain;
            set_by_lua_block $frontdoor_global_vars {
              local cjson = Cjson
              local executableRule, proxyServerName = {}, nil
              return cjson.encode({
                executableRule = executableRule,
                proxyServerName = proxyServerName
              })
            }
            
            rewrite_by_lua_file /usr/local/openresty/nginx/html/api/gateway_ack.lua;
            access_by_lua_file /usr/local/openresty/nginx/html/api/gateway_resp.lua;    # this code run just before the setting the proxy pass and content phase.

          # WSL Cache: Capture response headers for caching (always add debug headers)
          # Also apply custom response headers stored by gateway_resp.lua
          header_filter_by_lua_block {
            local ok, CacheHandler = pcall(require, "cache_handler")
            if ok then
              CacheHandler.process_response_headers()
            end

            -- Apply custom response headers (set by gateway_resp.lua in access phase)
            local custom_headers = ngx.ctx.custom_response_headers
            if custom_headers and type(custom_headers) == "table" then
              for _, header in ipairs(custom_headers) do
                if header.header_key and header.header_key ~= "" then
                  ngx.header[header.header_key] = header.header_value
                end
              end
            end
          }

          # WSL Cache: Capture response body for caching
          body_filter_by_lua_block {
            local ok, CacheHandler = pcall(require, "cache_handler")
            if ok and ngx.ctx.should_cache then
              CacheHandler.collect_response_body()
            end
          }

          # echo $proxy_host:$proxy_port;
          # echo $upstream_server;

          # Docker blob disk cache (controlled by Lua via $docker_cache_zone)
          proxy_cache $docker_cache_zone;
          proxy_cache_key $scheme$host$request_uri;
          proxy_cache_valid 200 30d;
          proxy_cache_valid 206 30d;
          proxy_cache_use_stale error timeout updating http_500 http_502 http_503 http_504 http_403 http_404;
          proxy_cache_revalidate on;
          proxy_cache_background_update on;
          proxy_cache_lock on;
          proxy_cache_lock_timeout 300s;
          add_header X-WSL-Docker-Cache $upstream_cache_status;

          proxy_ssl_protocols           TLSv1 TLSv1.1 TLSv1.2;
          proxy_ssl_ciphers             HIGH:!aNULL:!MD5;
          proxy_ssl_verify        off;
          proxy_ssl_verify_depth  2;
          proxy_ssl_session_reuse on;
          proxy_set_header X-Real-IP $remote_addr;
          proxy_ssl_server_name on;

          # WebSocket support
          proxy_http_version 1.1;
          proxy_set_header Upgrade $http_upgrade;
          proxy_set_header Connection $connection_upgrade;

          proxy_set_header x-route-server $proxy_route_server;
          proxy_set_header Host $proxy_host_override;
          proxy_pass $proxy_host_scheme://$upstream_server;
        
          }

