[Unit]
Description=Mirror wslproxy servers/rules/WAF policies from the source edge (lon1)
Documentation=file:///usr/local/share/doc/wslproxy-edge-sync/README.md
Wants=network-online.target
After=network-online.target openresty.service

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/wslproxy-edge-sync
TimeoutStartSec=300
Nice=10
