{
  "name": "prod-our-v1-wslproxy-local",
  "profile_id": "prod",
  "priority": 1,
  "match": {
    "rules": {
      "path": "/",
      "path_key": "starts_with",
      "client_ip_key": "equals",
      "country_key": "equals",
      "jwt_token_validation": "equals"
    },
    "response": {
      "code": 305,
      "redirect_uri": "127.0.0.1:8080",
      "allow": false,
      "message": "undefined",
      "is_consul": false
    }
  }
}
