        <mxCell id="feature-5" value="• SSL/TLS error monitoring (auto-ssl integration)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=10;" vertex="1" parent="legend-box">
          <mxGeometry x="360" y="165" width="320" height="20" as="geometry" />
        </mxCell>

        <mxCell id="feature-6" value="• Prometheus metrics with component labels" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=10;" vertex="1" parent="legend-box">
          <mxGeometry x="360" y="185" width="320" height="20" as="geometry" />
        </mxCell>

        <mxCell id="feature-7" value="• Load balancing: round-robin, least_conn, chash" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=10;" vertex="1" parent="legend-box">
          <mxGeometry x="20" y="205" width="320" height="20" as="geometry" />
        </mxCell>

        <mxCell id="feature-8" value="• Admin dashboard with real-time metrics visualization" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=10;" vertex="1" parent="legend-box">
          <mxGeometry x="360" y="205" width="320" height="20" as="geometry" />
        </mxCell>

        <!-- Data Flow Steps -->
        <mxCell id="flow-title" value="Configuration Flow:" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=14;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="50" y="760" width="200" height="30" as="geometry" />
        </mxCell>

        <mxCell id="step-1" value="1. DevOps creates WSLProxyBackend CRD via kubectl" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="50" y="790" width="700" height="20" as="geometry" />
        </mxCell>

        <mxCell id="step-2" value="2. Controller watches CRD changes and triggers reconciliation" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="50" y="810" width="700" height="20" as="geometry" />
        </mxCell>

        <mxCell id="step-3" value="3. WSLProxyBackendReconciler converts CRD spec to Lua-compatible JSON config" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="50" y="830" width="700" height="20" as="geometry" />
        </mxCell>

        <mxCell id="step-4" value="4. HTTPConfigUpdater sends POST request to OpenResty internal API (/api/internal/backends/{name})" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="50" y="850" width="700" height="20" as="geometry" />
        </mxCell>

        <mxCell id="step-5" value="5. Lua update_backend.lua receives config and updates shared dictionary (lua_shared_dict upstreams)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="50" y="870" width="700" height="20" as="geometry" />
        </mxCell>

        <mxCell id="step-6" value="6. dynamic_upstream.lua manages upstream server pool and health checks" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="50" y="890" width="700" height="20" as="geometry" />
        </mxCell>

        <mxCell id="step-7" value="7. balancer_by_lua_block performs dynamic load balancing for incoming requests" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="50" y="910" width="700" height="20" as="geometry" />
        </mxCell>

        <mxCell id="step-8" value="8. log_interceptor captures all nginx logs and increments Prometheus counters by component (ssl, auth, upstream, etc.)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="50" y="930" width="700" height="20" as="geometry" />
        </mxCell>

        <mxCell id="step-9" value="9. Prometheus scrapes /metrics endpoint for nginx_log_errors_total{component=&quot;ssl&quot;}, nginx_log_warnings_total, etc." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="50" y="950" width="700" height="20" as="geometry" />
        </mxCell>

        <mxCell id="step-10" value="10. Admin Dashboard queries Prometheus and displays SSL errors, log levels, and system health in real-time" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="50" y="970" width="700" height="20" as="geometry" />
        </mxCell>

        <!-- Traffic Flow Steps -->
        <mxCell id="traffic-flow-title" value="Traffic Flow:" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=14;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="800" y="760" width="200" height="30" as="geometry" />
        </mxCell>

        <mxCell id="traffic-1" value="1. Client sends HTTP/HTTPS request to OpenResty (:80, :443)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="800" y="790" width="700" height="20" as="geometry" />
        </mxCell>

        <mxCell id="traffic-2" value="2. OpenResty matches request to configured backend based on host/path rules" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="800" y="810" width="700" height="20" as="geometry" />
        </mxCell>

        <mxCell id="traffic-3" value="3. balancer_by_lua_block selects healthy upstream using configured algorithm (round-robin/least_conn/chash)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="800" y="830" width="700" height="20" as="geometry" />
        </mxCell>

        <mxCell id="traffic-4" value="4. Request proxied to selected backend server" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="800" y="850" width="700" height="20" as="geometry" />
        </mxCell>

        <mxCell id="traffic-5" value="5. Response returned to client through OpenResty" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="800" y="870" width="700" height="20" as="geometry" />
        </mxCell>

        <mxCell id="traffic-6" value="6. Metrics updated: nginx_http_requests_total, nginx_http_request_duration_seconds, nginx_log_messages_total" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="800" y="890" width="700" height="20" as="geometry" />
        </mxCell>

        <!-- Footer -->
        <mxCell id="footer" value="WSLProxy Ingress Controller - Kubernetes-native dynamic load balancing with OpenResty + Lua + Prometheus" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=12;fontStyle=2" vertex="1" parent="1">
          <mxGeometry x="400" y="1020" width="800" height="30" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
