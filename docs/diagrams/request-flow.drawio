        </mxCell>
        
        <!-- Step 4: WAF -->
        <mxCell id="step4" value="4️⃣ WAF Security Check&#xa;&#xa;🛡️ OWASP rules&#xa;🛡️ SQL injection check&#xa;🛡️ XSS prevention&#xa;🛡️ Rate limit check" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontStyle=1;align=left;spacingLeft=15;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="720" y="100" width="180" height="100" as="geometry"/>
        </mxCell>
        
        <!-- Step 5: Authentication -->
