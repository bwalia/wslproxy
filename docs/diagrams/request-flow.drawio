        <!-- Step 1: Client Request -->
        <mxCell id="step1" value="1️⃣ Client Request&#xa;&#xa;HTTPS://api.example.com/v1/users&#xa;Headers: Authorization, Accept&#xa;Method: GET/POST/PUT/DELETE" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;align=left;spacingLeft=15;fontSize=11;" vertex="1" parent="1">
