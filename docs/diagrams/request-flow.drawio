          <mxGeometry x="280" y="100" width="180" height="100" as="geometry"/>
        </mxCell>
        
        <!-- Step 3: SSL/TLS -->
        <mxCell id="step3" value="3️⃣ SSL/TLS Termination&#xa;&#xa;✅ Certificate validation&#xa;✅ TLS 1.3 handshake&#xa;✅ SNI routing" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;align=left;spacingLeft=15;fontSize=11;" vertex="1" parent="1">
