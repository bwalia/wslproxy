# global_backend
upstream global_backend {
  server 0.0.0.1:1000 max_fails=3 fail_timeout=5s;

  balancer_by_lua_block {
  local balancer = require "ngx.balancer"
  local host = ngx.var.proxy_host
  local port = ngx.var.proxy_port
  local backendHttps = ngx.var.proxy_host_scheme
  local ok, err = balancer.set_current_peer(host, port)
      if not ok then
      ngx.log(ngx.ERR, "balancer.set_current_peer failed to set the host " .. host .. ":" .. port .. " current peer: ", err)
      return ngx.exit(500)
      end

      -- Per-server proxy timeouts (set by gateway_resp.lua via ngx.ctx)
      local pt = ngx.ctx.proxy_timeouts
      if pt and balancer.set_timeouts then
          local ct = pt.connect_timeout or 60
          local st = pt.send_timeout or 60
          local rt = pt.read_timeout or 60
          local tok, terr = pcall(balancer.set_timeouts, ct, st, rt)
          if not tok then
              ngx.log(ngx.ERR, "balancer.set_timeouts failed: ", terr)
          end
      end
  }

  keepalive 10; # connection pool
}
