--              local host_ip_addr = resolver:resolve("kube-dns.kube-system.svc.cluster.local") -- kube-dns did not work
            local host_ip_addr = resolver:resolve("localhost")  -- localhost worked
            ngx.say(host_ip_addr)
            ngx.exit(ngx.HTTP_OK)
          }
        }

