# =============================================================================
# WSLProxy Admin UI - Environment Configuration
# =============================================================================
# Vite automatically loads .env files based on the mode:
#   .env                - always loaded (base defaults)
#   .env.local          - local overrides, always loaded (gitignored)
#   .env.[mode]         - mode-specific (e.g., .env.int when running --mode int)
#   .env.[mode].local   - mode-specific local overrides (gitignored)
#
# USAGE:
#   npm run dev              - uses .env (+ .env.local if present)
#   npm run dev:int          - uses .env + .env.int
#   npm run dev:prod         - uses .env + .env.prod
#   npm run dev:lan          - uses .env + .env.lan (+ .env.lan.local)
#   npm run dev:diytaxreturn - uses .env + .env.diytaxreturn
#
# Or use the interactive launcher from project root:
#   ./start.sh               - interactive menu
#   ./start.sh --env=int     - direct mode selection
#
# Only variables prefixed with VITE_ are exposed to the browser.
# See: https://vitejs.dev/guide/env-and-mode.html
# =============================================================================

# --- API Connection -----------------------------------------------------------
# The base URL for the WSLProxy admin API (must include /api path)
VITE_API_URL=http://localhost:8280/api

# The front-facing URL of the WSLProxy instance (used for sync/push operations)
VITE_FRONT_URL=http://localhost:8280

# --- Application Metadata ----------------------------------------------------
# Application version displayed in the footer
VITE_APP_VERSION=dev

# Build number displayed in the footer (auto-generated in CI)
VITE_APP_BUILD_NUMBER=local

# Deployment timestamp displayed in the footer
VITE_DEPLOYMENT_TIME=local-dev

# --- Platform -----------------------------------------------------------------
# Target platform identifier. Controls UI behavior:
#   (unset)      - Native/Ansible deployment (shows API Sync button)
#   DOCKER       - Docker deployment (hides API Sync button)
#   KUBERNATES   - Kubernetes deployment (hides API Sync button)
# VITE_TARGET_PLATFORM=

# --- Theme Customisation (optional) ------------------------------------------
# Override the default theme colors (hex WITHOUT the # prefix)
# VITE_THEME_SECONDARY_COLOR=45A049
# VITE_THEME_PRIMARY_COLOR=2E3A3C
# VITE_THEME_HOVER_COLOR=036408
