# LAN mode - for testing on mobile devices or other machines on local network
# Usage: ./start.sh --env=lan (auto-detects IP and writes .env.lan.local)
#
# start.sh will create .env.lan.local with the detected LAN IP, overriding
# the placeholder values below. You can also create it manually:
#   echo "VITE_API_URL=http://192.168.1.xxx:8280/api" > .env.lan.local
#   echo "VITE_FRONT_URL=http://192.168.1.xxx:8280" >> .env.lan.local
#
# In LAN mode, the Vite dev server binds to 0.0.0.0 (see vite.config.js).
VITE_API_URL=http://localhost:8280/api
VITE_FRONT_URL=http://localhost:8280
VITE_DEPLOYMENT_TIME=lan-dev
