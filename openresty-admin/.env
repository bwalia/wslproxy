# WSLProxy Admin UI - Base Environment
# Loaded in all Vite modes. Override locally with .env.local (gitignored).
# These defaults target the Docker-based dev environment (start.sh on port 8280).

# API and Frontend URLs
VITE_API_URL=/api
VITE_FRONT_URL=http://localhost:8280

# App metadata
VITE_APP_NAME=wslproxy
VITE_APP_DISPLAY_NAME=WSL Proxy
VITE_APP_VERSION=dev
VITE_APP_BUILD_NUMBER=local
VITE_DEPLOYMENT_TIME=local-dev

# Theme colors
VITE_THEME_PRIMARY_COLOR=2E3A3C
VITE_THEME_SECONDARY_COLOR=45A049
VITE_THEME_HOVER_COLOR=036408

# Platform identifier (DOCKER or BARE_METAL)
VITE_TARGET_PLATFORM=DOCKER

# JWT secret - injected by start.sh at runtime (do not hardcode)
VITE_JWT_SECURITY_PASSPHRASE=
