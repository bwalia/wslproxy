# WSLProxy Admin UI - Base Environment
# Loaded in all Vite modes. Override locally with .env.local (gitignored).
# These defaults target the Docker-based dev environment (./dev.sh on port 8280).
VITE_API_URL=http://localhost:8280/api
VITE_FRONT_URL=http://localhost:8280
VITE_APP_VERSION=dev
VITE_APP_BUILD_NUMBER=local
VITE_DEPLOYMENT_TIME=local-dev
